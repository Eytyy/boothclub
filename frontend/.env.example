NEXT_PUBLIC_SANITY_PROJECT_ID="<paste your project here>" # Required - The ID of your Sanity project
NEXT_PUBLIC_SANITY_DATASET="production" # Required - The dataset of your Sanity project
NEXT_PUBLIC_SANITY_API_VERSION="2025-09-25" # Optional - The API version provided to the Sanity Client
NEXT_PUBLIC_SANITY_STUDIO_URL="" #Optional, defaults to http://localhost:3333
SANITY_API_READ_TOKEN="<paste your token here>" # Required - The read token for your Sanity project

# Google Tag Manager
NEXT_PUBLIC_GTM_ID="<paste your GTM container ID here>" # Optional - GTM container ID (e.g. GTM-XXXXXXX); GTM loads sitewide when set

# Resend (contact form notifications + optional audience sync)
RESEND_API_KEY="<paste your Resend API key here>" # Required - Use Full access (not Sending access) so form submissions can both send email and sync opted-in contacts to a Segment
MAIL_FROM="Katch <notifications@your-verified-domain.com>" # Required - Verified sender address (friendly name optional). Domain must be verified in Resend.
RESEND_SEGMENT_ID="<paste your Resend segment ID here>" # Required for marketing opt-in sync - Segment ID contacts are added to when notifications is checked

# Public site origin (used to build absolute source URLs in notification emails, OG tags, etc.)
NEXT_PUBLIC_BASE_URL="http://localhost:3000" # Optional - Absolute origin (no trailing slash). When unset, notification emails omit the absolute source link.

# reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="<paste your reCAPTCHA site key here>" # Required - reCAPTCHA v3 site key (public)
RECAPTCHA_SECRET_KEY="<paste your reCAPTCHA secret key here>" # Required - reCAPTCHA v3 secret (server-only)
RECAPTCHA_MIN_SCORE="0.5" # Optional - Minimum v3 score (0.0-1.0) to accept; defaults to 0.5
