    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.72.1",
    "resend": "^6.20.0",
    "sanity": "^5.1.0",
    "sanity-image": "^1.0.0",
    "sanity-plugin-mux-input": "^5.0.12",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.17",
    "vanilla-cookieconsent": "^3.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.19.25",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
